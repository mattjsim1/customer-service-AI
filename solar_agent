# Solar savings calculation tool
@tool
def compute_savings(monthly_cost: float) -> dict:
    """
    Tool to compute the potential savings when switching to solar energy 
    based on the user's monthly electricity cost.
    
    Args:
        monthly_cost: Monthly electricity cost in dollars
        
    Returns:
        dict: Contains number_of_panels, installation_cost, net_savings_10_years
    """
    def calculate_solar_savings(monthly_cost):
        # Solar calculation parameters
        cost_per_kWh = 0.28
        cost_per_watt = 1.50
        sunlight_hours_per_day = 3.5
        panel_wattage = 350
        system_lifetime_years = 10

        # Calculate system requirements
        monthly_consumption_kWh = monthly_cost / cost_per_kWh
        daily_energy_production = monthly_consumption_kWh / 30
        system_size_kW = daily_energy_production / sunlight_hours_per_day

        # Calculate panels and costs
        number_of_panels = system_size_kW * 1000 / panel_wattage
        installation_cost = system_size_kW * 1000 * cost_per_watt

        # Calculate savings
        annual_savings = monthly_cost * 12
        total_savings_10_years = annual_savings * system_lifetime_years
        net_savings = total_savings_10_years - installation_cost

        return {
            "number_of_panels": round(number_of_panels),
            "installation_cost": round(installation_cost, 2),
            "net_savings_10_years": round(net_savings, 2),
            "monthly_cost": monthly_cost,
            "annual_savings": round(annual_savings, 2)
        }

    return calculate_solar_savings(monthly_cost)


# State definition
class State(TypedDict):
    messages: Annotated[List[AnyMessage], add_messages]


# Error handling for tools
def handle_tool_error(state) -> dict:
    error = state.get("error")
    tool_calls = state["messages"][-1].tool_calls
    return {
        "messages": [
            ToolMessage(
                content=f"Error: {repr(error)}\nPlease fix your mistakes.",
                tool_call_id=tc["id"],
            )
            for tc in tool_calls
        ]
    }


def create_tool_node_with_fallback(tools: list) -> ToolNode:
    return ToolNode(tools).with_fallbacks(
        [RunnableLambda(handle_tool_error)],
        exception_key="error"
    )


# Assistant class
class Assistant:
    def __init__(self, runnable: Runnable):
        self.runnable = runnable

    def __call__(self, state: State):
        while True:
            result = self.runnable.invoke(state)
            # Check if we got a valid response
            if not getattr(result, "tool_calls", None) and (
                not getattr(result, "content", None) or
                (isinstance(result.content, list) and 
                 not result.content[0].get("text", "").strip())
            ):
                # Re-prompt for a real output
                messages = state["messages"] + [
                    HumanMessage(content="Please respond with a real output.")
                ]
                state = {**state, "messages": messages}
            else:
                break
        return {"messages": result}


# AWS Bedrock setup with secure credential handling
def setup_credentials_from_file(credentials_file: str = "aws_credentials.txt"):
    """
    Load credentials from a local file (for development only).
    File format should be:
    AWS_ACCESS_KEY_ID=your_access_key_here
    AWS_SECRET_ACCESS_KEY=your_secret_key_here
    """
    print(f"Looking for credentials file: {credentials_file}")
    print(f"Current working directory: {os.getcwd()}")
    
    if os.path.exists(credentials_file):
        print(f"✅ Found credentials file: {credentials_file}")
        with open(credentials_file, 'r') as f:
            lines = f.readlines()
            print(f"File has {len(lines)} lines")
            
            for line_num, line in enumerate(lines, 1):
                line = line.strip()
                print(f"Line {line_num}: '{line}'")
                
                if line and not line.startswith('#'):
                    if '=' in line:
                        key, value = line.split('=', 1)
                        key = key.strip()
                        value = value.strip()
                        os.environ[key] = value
                        print(f"✅ Set {key} = {value[:10]}...")  # Only show first 10 chars for security
        
        # Verify credentials were set
        access_key = os.environ.get('AWS_ACCESS_KEY_ID')
        secret_key = os.environ.get('AWS_SECRET_ACCESS_KEY')
        
        if access_key and secret_key:
            print(f"Credentials loaded successfully!")
            print(f"Access Key: {access_key[:10]}...")
            print(f"Secret Key: {secret_key[:10]}...")
            return True
        else:
            print("Credentials not found in environment after loading file")
            return False


def exponential_backoff_retry(func, max_retries=5, base_delay=1, max_delay=60):
    """
    Execute a function with exponential backoff retry logic.
    
    Args:
        func: Function to execute
        max_retries: Maximum number of retry attempts
        base_delay: Initial delay in seconds
        max_delay: Maximum delay between retries
    
    Returns:
        Function result or raises the last exception
    """
    for attempt in range(max_retries + 1):
        try:
            return func()
        except Exception as e:
            if attempt == max_retries:
                raise e
            
            # Check if it's a rate limiting error
            if any(error_type in str(e) for error_type in [
                "ThrottlingException", 
                "Too many requests", 
                "RateLimitError",
                "rate limit"
            ]):
                # Calculate delay with exponential backoff and jitter
                delay = min(base_delay * (2 ** attempt), max_delay)
                jitter = random.uniform(0.1, 0.3) * delay  # Add 10-30% jitter
                total_delay = delay + jitter
                
                print(f"Rate limit hit (attempt {attempt + 1}/{max_retries + 1}). "
                      f"Waiting {total_delay:.1f} seconds before retry...")
                time.sleep(total_delay)
            else:
                # For non-rate-limiting errors, re-raise immediately
                raise e


def safe_stream_with_backoff(graph, input_data, config, max_retries=3):
    """
    Stream graph events with exponential backoff for rate limiting.
    """
    def stream_function():
        return list(graph.stream(input_data, config, stream_mode="values"))
    
    return exponential_backoff_retry(
        stream_function, 
        max_retries=max_retries, 
        base_delay=5,  # Start with 5 seconds
        max_delay=120  # Max 2 minutes between retries
    )


def get_bedrock_client(region: str = "us-east-2"):
    """
    Create Bedrock client using secure credential methods.
    
    Priority order:
    1. Environment variables (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)
    2. AWS credentials file (~/.aws/credentials)
    3. IAM roles (for EC2/Lambda/ECS)
    4. AWS CLI configuration
    """
    try:
        # Check if credentials are available in environment
        if os.getenv("AWS_ACCESS_KEY_ID") and os.getenv("AWS_SECRET_ACCESS_KEY"):
            print("Using AWS credentials from environment variables")
        else:
            print("Using AWS default credential chain (CLI/IAM roles/credentials file)")
        
        return boto3.client("bedrock-runtime", region_name=region)
    
    except Exception as e:
        print(f"Error creating Bedrock client: {e}")
        print("\nCredential setup options:")
        print("1. Set environment variables: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY")
        print("2. Run 'aws configure' to setup AWS CLI credentials")
        print("3. Use IAM roles if running on AWS infrastructure")
        print("4. Create ~/.aws/credentials file manually")
        raise


def create_bedrock_llm(client, model_id: str):
    """Create ChatBedrock instance with retry configuration"""
    return ChatBedrock(
        model_id=model_id,
        provider="anthropic",
        client=client,
        model_kwargs={
            'temperature': 0,
            'max_tokens': 5000
        },
        region_name=client.meta.region_name
    )


# Create the solar assistant
def create_solar_assistant(model_id: str = None, credentials_file: str = None):
    """
    Create a solar savings assistant agent
    
    Args:
        model_id: Bedrock model ID or inference profile ARN
        credentials_file: Optional path to credentials file for development
    """
    # Setup credentials if file is provided
    if credentials_file:
        setup_credentials_from_file(credentials_file)
    
    # Use your inference profile ARN
    if model_id is None:
        model_id = "arn:aws:bedrock:us-east-2:554000693710:inference-profile/global.anthropic.claude-sonnet-4-20250514-v1:0"
    
    # Create LLM
    bedrock_client = get_bedrock_client()
    llm = create_bedrock_llm(bedrock_client, model_id)
    
    # System prompt
    system_text = """You are a helpful customer support assistant for Solar Panels Belgium.

Your task is to help customers calculate their potential solar energy savings.

You need to gather the following information:
- Monthly electricity cost (in dollars)

Important guidelines:
- If you cannot determine the monthly electricity cost, ask the customer to clarify
- Do not guess or assume values
- Once you have the monthly cost, use the compute_savings tool to calculate savings
- Present the results in a friendly, informative way
- Explain what the numbers mean in practical terms

After calculating, explain:
- How many solar panels they would need
- The installation cost
- Their net savings over 10 years
- How this translates to annual savings
"""

    # Create prompt template
    if HAS_MESSAGES_PLACEHOLDER:
        prompt = ChatPromptTemplate.from_messages([
            ("system", system_text),
            MessagesPlaceholder(variable_name="messages"),
        ])
    else:
        # Fallback for older versions
        prompt = ChatPromptTemplate.from_messages([
            ("system", system_text),
            ("human", "{messages}"),
        ])

    # Tools
    tools = [compute_savings]
    
    # Create runnable with tool binding
    assistant_runnable = prompt | llm.bind_tools(tools)
    
    # Build state graph
    builder = StateGraph(State)
    builder.add_node("assistant", Assistant(assistant_runnable))
    builder.add_node("tools", create_tool_node_with_fallback(tools))
    
    builder.add_edge(START, "assistant")
    builder.add_conditional_edges("assistant", tools_condition)
    builder.add_edge("tools", "assistant")
    
    # Compile graph
    graph = builder.compile()
    
    return graph


# Example usage
def run_example():
    """Run example conversation"""
    
    # Create the assistant
    graph = create_solar_assistant()
    
    # Create conversation thread
    thread_id = str(uuid.uuid4())
    config = {"configurable": {"thread_id": thread_id}}
    
    # Example questions - uncomment for testing
    
    questions = [
        "Hi there!",
        "I want to know about solar savings",
        "My monthly electricity bill is $120"
    ]
    
    print("=== Solar Savings Assistant Demo ===\n")
    
    # Process each question with delays to avoid rate limiting
    for i, question in enumerate(questions, 1):
        print(f"User ({i}): {question}")
        
        # Add delay between requests to avoid throttling
        if i > 1:
            print("(Waiting to avoid rate limits...)")
            time.sleep(10)
        
        try:
            # Stream the response
            events = graph.stream(
                {"messages": [HumanMessage(content=question)]}, 
                config, 
                stream_mode="values"
            )
            
            for event in events:
                if "messages" in event:
                    last_message = event["messages"][-1]
                    if hasattr(last_message, 'content') and last_message.content:
                        if isinstance(last_message, AIMessage):
                            print(f"Assistant: {last_message.content}")
                        elif isinstance(last_message, ToolMessage):
                            print(f"Tool Result: {last_message.content}")
                            
        except Exception as e:
            if "ThrottlingException" in str(e) or "Too many requests" in str(e):
                print(f"Rate limit hit. Waiting 10 seconds and retrying...")
                time.sleep(10)
                # Retry once
                try:
                    events = graph.stream(
                        {"messages": [HumanMessage(content=question)]}, 
                        config, 
                        stream_mode="values"
                    )
                    
                    for event in events:
                        if "messages" in event:
                            last_message = event["messages"][-1]
                            if hasattr(last_message, 'content') and last_message.content:
                                if isinstance(last_message, AIMessage):
                                    print(f"Assistant: {last_message.content}")
                                elif isinstance(last_message, ToolMessage):
                                    print(f"Tool Result: {last_message.content}")
                except Exception as retry_error:
                    print(f"Retry failed: {retry_error}")
            else:
                print(f"Error: {e}")
        
        print("-" * 50)


# Utility function to create a simple chat interface
def create_chat_interface():
    """Create an interactive chat interface"""
    graph = create_solar_assistant()
    thread_id = str(uuid.uuid4())
    config = {"configurable": {"thread_id": thread_id}}
    
    print("=== Solar Savings Calculator ===")
    print("Type 'quit' to exit\n")
    
    while True:
        user_input = input("You: ").strip()
        
        if user_input.lower() in ['quit', 'exit', 'bye']:
            print("Goodbye!")
            break
            
        if not user_input:
            continue
        
        try:
            # Process the message
            events = graph.stream(
                {"messages": [HumanMessage(content=user_input)]}, 
                config, 
                stream_mode="values"
            )
            
            for event in events:
                if "messages" in event:
                    last_message = event["messages"][-1]
                    if hasattr(last_message, 'content') and last_message.content:
                        if isinstance(last_message, AIMessage):
                            print(f"Assistant: {last_message.content}\n")
                            
        except Exception as e:
            print(f"Error: {e}\n")


