# Create the solar assistant
def create_solar_assistant(model_id: str = None):
    """
    Create a solar savings assistant agent
    
    Args:
        model_id: Bedrock model ID or inference profile ARN
    """
    # Use your inference profile ARN
    if model_id is None:
        model_id = "arn:aws:bedrock:us-east-2:554000693710:inference-profile/global.anthropic.claude-sonnet-4-20250514-v1:0"
    
    # Create LLM
    bedrock_client = get_bedrock_client()
    llm = create_bedrock_llm(bedrock_client, model_id)
    
    # System prompt
    system_text = """You are a helpful customer support assistant for Solar Panels Belgium.

Your task is to help customers calculate their potential solar energy savings.

You need to gather the following information:
- Monthly electricity cost (in dollars)

Important guidelines:
- If you cannot determine the monthly electricity cost, ask the customer to clarify
- Do not guess or assume values
- Once you have the monthly cost, use the compute_savings tool to calculate savings
- Present the results in a friendly, informative way
- Explain what the numbers mean in practical terms

After calculating, explain:
- How many solar panels they would need
- The installation cost
- Their net savings over 10 years
- How this translates to annual savings
"""

    # Create prompt template
    if HAS_MESSAGES_PLACEHOLDER:
        prompt = ChatPromptTemplate.from_messages([
            ("system", system_text),
            MessagesPlaceholder(variable_name="messages"),
        ])
    else:
        # Fallback for older versions
        prompt = ChatPromptTemplate.from_messages([
            ("system", system_text),
            ("human", "{messages}"),
        ])

    # Tools
    tools = [compute_savings]
    
    # Create runnable with tool binding
    assistant_runnable = prompt | llm.bind_tools(tools)
    
    # Build state graph
    builder = StateGraph(State)
    builder.add_node("assistant", Assistant(assistant_runnable))
    builder.add_node("tools", create_tool_node_with_fallback(tools))
    
    builder.add_edge(START, "assistant")
    builder.add_conditional_edges("assistant", tools_condition)
    builder.add_edge("tools", "assistant")
    
    # Compile graph
    graph = builder.compile()
    
    return graph


# Example usage
def run_example():
    """Run example conversation"""
    
    # Create the assistant
    graph = create_solar_assistant()
    
    # Create conversation thread
    thread_id = str(uuid.uuid4())
    config = {"configurable": {"thread_id": thread_id}}
    
    # Example questions
    questions = [
        "Hi there!",
        "I want to know about solar savings",
        "My monthly electricity bill is $120"
    ]
    
    print("=== Solar Savings Assistant Demo ===\n")
    
    # Process each question
    for i, question in enumerate(questions, 1):
        print(f"User ({i}): {question}")
        
        # Stream the response
        events = graph.stream(
            {"messages": [HumanMessage(content=question)]}, 
            config, 
            stream_mode="values"
        )
        
        for event in events:
            if "messages" in event:
                last_message = event["messages"][-1]
                if hasattr(last_message, 'content') and last_message.content:
                    if isinstance(last_message, AIMessage):
                        print(f"Assistant: {last_message.content}")
                    elif isinstance(last_message, ToolMessage):
                        print(f"Tool Result: {last_message.content}")
        
        print("-" * 50)


# Utility function to create a simple chat interface
def create_chat_interface():
    """Create an interactive chat interface"""
    graph = create_solar_assistant()
    thread_id = str(uuid.uuid4())
    config = {"configurable": {"thread_id": thread_id}}
    
    print("=== Solar Savings Calculator ===")
    print("Type 'quit' to exit\n")
    
    while True:
        user_input = input("You: ").strip()
        
        if user_input.lower() in ['quit', 'exit', 'bye']:
            print("Goodbye!")
            break
            
        if not user_input:
            continue
        
        try:
            # Process the message
            events = graph.stream(
                {"messages": [HumanMessage(content=user_input)]}, 
                config, 
                stream_mode="values"
            )
            
            for event in events:
                if "messages" in event:
                    last_message = event["messages"][-1]
                    if hasattr(last_message, 'content') and last_message.content:
                        if isinstance(last_message, AIMessage):
                            print(f"Assistant: {last_message.content}\n")
                            
        except Exception as e:
            print(f"Error: {e}\n")


